---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Warch — Twój Arch Linux dla graczy',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Warch"
    actions={[
      {
        variant: 'primary',
        text: 'Pobierz Warcha',
        href: 'https://github.com/nieznamsim/warch-iso',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Dowiedz się więcej', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Warch Hero Image' }}
  >
    <Fragment slot="title">
      Witaj, Żołnierzu! <span class="hidden xl:inline">w Naszym</span>
      <span class="text-accent dark:text-white"> Systemie Operacyjnym</span>
    </Fragment>

    <Fragment slot="subtitle">
      Warch to system skierowany do graczy (no chyba że grasz w gry, które używają Vanguarda jako anty-cheata oraz do graczy FN to nie).
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="Funkcje"
    title="Dlaczego Warch?"
    subtitle="Wszystko, czego potrzebujesz do grania, w jednym miejscu."
    items={[
      {
        title: 'Zoptymalizowane jądro',
        description: 'Oparte na linux-zen, gotowe do gier i codziennej pracy.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Gotowe do gier',
        description: 'Steam, Proton GE, MangoHud, Gamemode – wszystko preinstalowane.',
        icon: 'tabler:device-gamepad-2',
      },
      {
        title: 'Szybkość i wydajność',
        description: 'Arch Linux zoptymalizowany pod kątem maksymalnej liczby klatek na sekundę.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Twoja kontrola',
        description: 'Pełna kontrola nad systemem. Bez bloatware, bez kompromisów.',
        icon: 'tabler:settings',
      },
      {
        title: 'Aktualizacje na bieżąco',
        description: 'Najnowsze sterowniki i oprogramowanie dzięki modelowi rolling-release.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Społeczność',
        description: 'Oparte na Arch Linux. Zbudowane przez gracza, dla graczy.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Content
    isReversed
    tagline="W środku"
    title="Co znajdziesz w Warchu?"
    items={[
      {
        title: 'Jądro linux-zen',
        description: 'Zoptymalizowane pod gry, z lepszym schedulerem i responsywnością.',
      },
      {
        title: 'KDE Plasma',
        description: 'Nowoczesne, konfigurowalne środowisko graficzne, gotowe do pracy i zabawy.',
      },
      {
        title: 'Graficzny instalator',
        description: 'Zapomnij o wpisywaniu komend. Instalacja krok po kroku, jak w każdym innym systemie.',
      },
      {
        title: 'Narzędzia gracza',
        description: 'Steam, Lutris, Heroic, ProtonUp-Qt, MangoHud, Gamemode – wszystko na miejscu.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2070&q=80',
      alt: 'Warch Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Zbudowany na sprawdzonych fundamentach</h3>
      Oparte na Arch Linux, zoptymalizowane pod gry.
    </Fragment>
  </Content>

  <FAQs
    id="faqs"
    title="Często zadawane pytania"
    subtitle="Najważniejsze pytania o Warcha."
    tagline="FAQ"
    items={[
      {
        title: 'Czym jest Warch?',
        description: 'To lekka, szybka i w pełni Twoja dystrybucja Linuksa oparta na Arch Linux, stworzona z myślą o graczach. (ale głównie z myślą o twórcy więc nie wymagaj cudów :p)',
      },
            {
        title: 'Czy jest darmowy?',
        description: 'Tak, Warch jest w 100% darmowy i open source, oparty na wolnym oprogramowaniu (m.in. jądro Linux na licencji GPLv2).',
      },
          {
        title: 'Jakie jądro jest używane?',
        description: 'Domyślnie używamy linux-zen, zoptymalizowanego pod gry. (ale możliwe że zostanie zmieniony w jakiejś odległej przyszłości na linux-cachyos)',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Pobierz Warcha',
        href: 'https://github.com/nieznamsim/warch-iso',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Warch&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Arch Linux</span>
    </Fragment>

    <Fragment slot="subtitle">
      Darmowy, open source i gotowy do gier. <br class="hidden md:inline" />Pobierz, zainstaluj i graj.
    </Fragment>
  </CallToAction>
</Layout>
